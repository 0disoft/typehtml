{
  "format": "boundary-contract/0.5-draft",
  "status": "design-reference",
  "id": "orders.createDraft",
  "operation": "write",
  "sourceMode": "json-authoritative",
  "http": {
    "method": "POST",
    "path": "/actions/orders/create-draft",
    "body": "urlencoded",
    "maxBytes": 16384,
    "maxEntries": 16,
    "maxKeyBytes": 64,
    "maxValueBytes": 1024,
    "charset": "utf-8",
    "contentEncoding": "identity-only",
    "parserProfile": "strict-urlencoded-utf8/1"
  },
  "protocol": {
    "csrfField": "_bc_csrf",
    "requestKeyField": "_bc_request",
    "countProtocolEntries": true
  },
  "input": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productId",
        "quantity"
      ],
      "properties": {
        "productId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      }
    },
    "codecs": {
      "productId": "text",
      "quantity": "decimal-integer"
    },
    "unknownKeys": "reject",
    "duplicateScalars": "reject",
    "scalarSemantics": {
      "missing": "absent",
      "emptyString": "preserve",
      "textNormalization": "none",
      "schemaStringLength": "unicode-code-points",
      "validationMutatesData": false
    }
  },
  "serverOwnedFields": [
    "customerId",
    "tenantId",
    "priceMinor",
    "totalMinor"
  ],
  "bindings": {
    "module": "../reference/order-bindings.ts",
    "export": "buildOrderBindings",
    "kind": "typed-factory",
    "roleType": "BindingRoleMap"
  },
  "guards": {
    "csrf": "session-synchronizer",
    "originProfile": "same-origin-with-referer-fallback",
    "transaction": "sqlite-immediate-sync",
    "resourceRevision": "required-cas",
    "idempotency": {
      "intent": "server-persisted",
      "intentTtlSeconds": 86400,
      "resultRetentionSeconds": 86400,
      "busyRetryBudgetMs": 5000,
      "retryAfterSeconds": 1,
      "replay": "current-receipt-authorization",
      "digest": "boundary-behavior/1",
      "issuedResourceRevision": "required",
      "missingIntent": "never-create-on-submit",
      "resultStorage": "receipt-reference",
      "expiryComparison": "now-greater-than-or-equal",
      "statePolicy": "intent-state/2",
      "readConsistency": "fresh-local-snapshot",
      "replayLock": "read-only-transaction",
      "corruption": "500-preserve-evidence"
    }
  },
  "output": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orderId",
        "state",
        "totalMinor",
        "currency"
      ],
      "properties": {
        "orderId": {
          "type": "string",
          "pattern": "^draft_[A-Za-z0-9_-]{1,58}$",
          "maxLength": 64
        },
        "state": {
          "type": "string",
          "const": "draft"
        },
        "totalMinor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "currency": {
          "type": "string",
          "const": "KRW"
        }
      }
    },
    "cache": "private-no-store",
    "mode": "explicit-projection"
  },
  "page": {
    "path": "/orders/new",
    "viewSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productId",
        "productName",
        "unitPriceMinor",
        "currency",
        "productRevision"
      ],
      "properties": {
        "productId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "productName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "unitPriceMinor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "currency": {
          "type": "string",
          "const": "KRW"
        },
        "productRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "initialResponse": {
      "status": 200,
      "renderer": "renderStart"
    },
    "intentInitialization": {
      "status": 303,
      "location": "/orders/new?intent={intentId}",
      "method": "POST",
      "path": "/actions/orders/begin-draft",
      "csrf": "session-synchronizer",
      "inputFields": [
        "productId"
      ],
      "authorization": "current-product-policy",
      "snapshot": "store-resource-revision",
      "getCreatesIntent": false
    },
    "queryModes": [
      "productId",
      "intent"
    ],
    "authorization": "current-product-policy",
    "resolver": "resolvePage"
  },
  "response": {
    "mode": "native-html",
    "success": {
      "status": 303,
      "route": "receipt",
      "parameterFrom": "output.orderId"
    },
    "invalid": {
      "status": 422,
      "renderer": "renderForm",
      "preserve": "allowed-bounded-raw-values",
      "keepIntent": true
    },
    "receipt": {
      "method": "GET",
      "path": "/orders/drafts/:orderId",
      "load": "loadReceipt",
      "authorize": "authorizeReceipt",
      "project": "projectReceipt",
      "renderer": "renderReceipt"
    },
    "deniedOrMissing": 404,
    "otherErrors": "escaped-generic-html"
  },
  "headers": {
    "cacheControl": "private, no-store",
    "contentType": "text/html; charset=utf-8",
    "xContentTypeOptions": "nosniff",
    "referrerPolicy": "same-origin",
    "contentSecurityPolicy": "default-src 'none'; script-src 'none'; style-src 'self'; img-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
  },
  "operationRevision": 2
}
