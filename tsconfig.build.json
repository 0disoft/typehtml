{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": false,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "outDir": "dist",
    "target": "ES2022"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["test", "examples", "scripts", "node_modules", "dist"]
}
